{
  "name": "hollis-and-vane",
  "version": "1.0.0",
  "private": true,
  "description": "Hollis & Vane \u2014 a storefront for classy vintage clothing. Static, dependency-free.",
  "scripts": {
    "build": "node scripts/build.js",
    "art": "python3 scripts/generate-art.py",
    "dev": "node scripts/build.js && node scripts/serve.js",
    "serve": "node scripts/serve.js",
    "arcade": "node scripts/build-arcade.js",
    "arcade:check": "node scripts/validate-arcade.js",
    "arcade:regress": "node scripts/arcade-regression.js --compare arcade/backup/regression-baseline.json"
  },
  "license": "MIT"
}
