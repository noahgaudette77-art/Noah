# secrets and scratch output never go in the repo
.env
.env.*
tools/gen/out/
.work/
# a capture's frames while a strip is being made (the tool joins them into one JPG and deletes them)
docs/**/*-[0-9][0-9].png
# the site a web host publishes, made by tools/pages-site.sh on the host itself
site/
# a harness run's raw output (tools/harness.js): scratch; each phase's gate keeps its report and pictures in
# docs/master/<phase>/ (the baseline's first run stays as it was committed)
docs/master/runs/*
!docs/master/runs/baseline/
# the overhaul's baseline build, put back for a measurement against it (never committed)
index.baseline.html
